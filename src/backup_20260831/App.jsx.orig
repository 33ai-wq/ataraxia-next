import { useState, useEffect, useCallback, useRef } from 'react';
import SoundPlayer from './components/SoundPlayer';
import Sanctuary from './Sanctuary';

const CONFIG = {
  base: {
    chainId: 8453,
    name: 'Base',
    rpc: 'https://mainnet.base.org',
    usdcAddress: '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913',
    usdcDecimals: 6,
    treasuryAddress: '0x57EEC52d76A4A78D4562fc2564101A4bD2e3F357',
    explorer: 'https://basescan.org/tx/'
  },
  solana: {
    name: 'Solana',
    rpc: 'https://api.mainnet-beta.solana.com',
    usdcMint: 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v',
    usdcDecimals: 6,
    treasuryAddress: 'GhFbGgNxERN6pQ7boSFLFJuPwXJuvJ8Tx7EgoJ9LV2Aw',
    explorer: 'https://solscan.io/tx/'
  },
  amount: '0.1',
  requiredConfirmations: { base: 12, solana: 32 }
};

function App() {
  const [phase, setPhase] = useState('landing'); // landing | connecting | paying | verifying | sanctuary
  const [wallet, setWallet] = useState(null); // { type: 'metamask'|'phantom', address: string, chain: 'base'|'solana' }
  const [selectedChain, setSelectedChain] = useState(null);
  const [txHash, setTxHash] = useState(null);
  const [confirmations, setConfirmations] = useState(0);
  const [toast, setToast] = useState({ message: '', type: 'info', show: false });
  const [isSoundPlayerReady, setIsSoundPlayerReady] = useState(false);
  const verificationIntervalRef = useRef(null);

  const showToast = useCallback((message, type = 'info') => {
    setToast({ message, type, show: true });
    setTimeout(() => setToast({ message: '', type: 'info', show: false }), 4000);
  }, []);

  const formatAddress = (addr) => {
    if (!addr) return '';
    return addr.slice(0, 6) + '...' + addr.slice(-4);
  };

  const resetFlow = useCallback(() => {
    setWallet(null);
    setSelectedChain(null);
    setTxHash(null);
    setConfirmations(0);
    setPhase('landing');
    if (verificationIntervalRef.current) {
      clearInterval(verificationIntervalRef.current);
      verificationIntervalRef.current = null;
    }
  }, []);

  const connectMetaMask = async () => {
    try {
      if (!window.ethereum) throw new Error('MetaMask not installed');
      const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
      if (!accounts.length) throw new Error('No accounts found');
      setWallet({ type: 'metamask', address: accounts[0], chain: 'base' });
      showToast(`Connected: ${formatAddress(accounts[0])}`, 'success');
    } catch (e) {
      showToast(e.message, 'error');
    }
  };

  const connectPhantom = async () => {
    try {
      if (!window.solana || !window.solana.isPhantom) throw new Error('Phantom not installed');
      const resp = await window.solana.connect({ onlyIfTrusted: false });
      setWallet({ type: 'phantom', address: resp.publicKey.toString(), chain: 'solana' });
      showToast(`Connected: ${formatAddress(resp.publicKey.toString())}`, 'success');
    } catch (e) {
      showToast(e.message, 'error');
    }
  };

  const initiatePayment = async () => {
    if (!wallet || !selectedChain) return;
    setPhase('paying');
    const chainCfg = CONFIG[selectedChain];

    if (selectedChain === 'base') {
      await sendBasePayment(chainCfg);
    } else {
      await sendSolanaPayment(chainCfg);
    }
  };

  const sendBasePayment = async (cfg) => {
    try {
      const { createWalletClient, custom, parseUnits } = await import('viem');
      const { base } = await import('viem/chains');
      
      const client = createWalletClient({
        chain: { id: cfg.chainId, name: cfg.name, rpcUrls: { default: { http: [cfg.rpc] } } },
        transport: custom(window.ethereum)
      });

      const amount = parseUnits(CONFIG.amount, cfg.usdcDecimals);
      const hash = await client.writeContract({
        address: cfg.usdcAddress,
        abi: [{ name: 'transfer', type: 'function', stateMutability: 'nonpayable', inputs: [{ name: 'to', type: 'address' }, { name: 'value', type: 'uint256' }], outputs: [{ type: 'bool' }] }],
        functionName: 'transfer',
        args: [cfg.treasuryAddress, amount]
      });

      setTxHash(hash);
      startVerification('base', hash);
    } catch (e) {
      showToast(`Payment failed: ${e.message}`, 'error');
      resetFlow();
    }
  };

  const sendSolanaPayment = async (cfg) => {
    try {
      const { Connection, Transaction, PublicKey } = await import('@solana/web3.js');
      const { createTransferInstruction, getAssociatedTokenAddress, getAccount, createAssociatedTokenAccountInstruction } = await import('@solana/spl-token');
      
      const connection = new Connection(cfg.rpc, 'confirmed');
      const fromPubkey = new PublicKey(wallet.address);
      const treasuryPubkey = new PublicKey(cfg.treasuryAddress);
      const usdcMint = new PublicKey(cfg.usdcMint);

      const fromAta = await getAssociatedTokenAddress(usdcMint, fromPubkey);
      const toAta = await getAssociatedTokenAddress(usdcMint, treasuryPubkey);

      const ixs = [];
      try {
        await getAccount(connection, toAta);
      } catch {
        ixs.push(createAssociatedTokenAccountInstruction(fromPubkey, toAta, treasuryPubkey, usdcMint));
      }

      const amount = BigInt(Math.round(parseFloat(CONFIG.amount) * Math.pow(10, cfg.usdcDecimals)));
      ixs.push(createTransferInstruction(fromAta, toAta, fromPubkey, amount, []));

      const tx = new Transaction().add(...ixs);
      tx.feePayer = fromPubkey;
      tx.recentBlockhash = (await connection.getLatestBlockhash()).blockhash;

      const signed = await window.solana.signTransaction(tx);
      const signature = await connection.sendRawTransaction(signed.serialize());

      setTxHash(signature);
      startVerification('solana', signature);
    } catch (e) {
      showToast(`Payment failed: ${e.message}`, 'error');
      resetFlow();
    }
  };

  const startVerification = (chain, hash) => {
    setPhase('verifying');
    const cfg = CONFIG[chain];
    const confirmationsNeeded = CONFIG.requiredConfirmations[chain];
    const targetHash = hash || txHash;
    let lastConf = 0;

    verificationIntervalRef.current = setInterval(async () => {
      try {
        let conf = 0;
        if (chain === 'base') {
          const { createPublicClient, http } = await import('viem');
          const client = createPublicClient({ chain: { id: cfg.chainId, rpcUrls: { default: { http: [cfg.rpc] } } }, transport: http(cfg.rpc) });
          const receipt = await client.getTransactionReceipt({ hash: targetHash });
          if (receipt) conf = 12;
        } else {
          const { Connection } = await import('@solana/web3.js');
          const connection = new Connection(cfg.rpc, 'confirmed');
          const status = await connection.getSignatureStatus(targetHash, { searchTransactionHistory: true });
          if (status.value && status.value.confirmationStatus === 'finalized') conf = 32;
          else if (status.value && status.value.confirmations) conf = status.value.confirmations;
        }

        if (conf !== lastConf) {
          setConfirmations(conf);
          lastConf = conf;
        }

        if (conf >= confirmationsNeeded) {
          clearInterval(verificationIntervalRef.current);
          verificationIntervalRef.current = null;
          setTimeout(() => {
            setPhase('sanctuary');
            showToast('Welcome to Ataraxia', 'success');
            // Trigger sound player to start
            if (window.__ataraxiaSoundPlayer) {
              window.__ataraxiaSoundPlayer.play();
            }
          }, 1500);
        }
      } catch (e) {
        console.error('Verification error:', e);
      }
    }, 5000);
  };

  const handleEnterSanctuary = () => {
    if (!wallet) {
      // If no wallet connected, show wallet options
      setPhase('connecting');
    } else if (!selectedChain) {
      setPhase('connecting');
    } else {
      initiatePayment();
    }
  };

  useEffect(() => {
    return () => {
      if (verificationIntervalRef.current) {
        clearInterval(verificationIntervalRef.current);
      }
    };
  }, []);

  if (phase === 'sanctuary') {
    return <Sanctuary wallet={wallet} onExit={resetFlow} />;
  }

  return (
    <div className="min-h-screen bg-bg flex flex-col">
      {/* Toast */}
      {toast.show && (
        <div className="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 animate-slideUp">
          <div className={`px-6 py-3 rounded-xl border shadow-xl text-sm ${
            toast.type === 'success' ? 'border-accent bg-card' :
            toast.type === 'error' ? 'border-danger bg-card' :
            'border-border bg-card'
          }`}>
            {toast.message}
          </div>
        </div>
      )}

      {/* Landing Phase */}
      {phase === 'landing' && (
        <main className="flex-1 flex flex-col items-center justify-center px-4 py-12 relative">
          {/* Background ambient glow */}
          <div className="absolute inset-0 overflow-hidden pointer-events-none">
            <div className="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/10 rounded-full blur-3xl animate-pulse" />
            <div className="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl animate-pulse" style={{ animationDelay: '2s' }} />
          </div>

          <div className="relative z-10 text-center max-w-2xl mx-auto">
            {/* Logo/Title */}
            <h1 className="font-heading text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-gradient-to-r from-fg via-accent to-fg bg-clip-text text-transparent animate-fade-in">
              Enter Ataraxia
            </h1>
            
            <p className="text-fg-muted text-lg md:text-xl mb-4 max-w-xl mx-auto">
              A wallet-gated sanctuary for calm. Breathe. Listen. Play with sand.
            </p>
            
            <p className="text-fg-muted text-base md:text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
              Reconnect with yourself. Immerse in gentle soundscapes, follow guided breathwork, and draw in a zen sand garden. No data tracked. Just you and the moment.
            </p>

            {/* Breathing preview */}
            <div className="mb-10">
              <div className="relative w-48 h-48 mx-auto">
                <div className="absolute inset-0 border border-border/50 rounded-full" />
                <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-full bg-gradient-to-br from-accent to-[#008a6d] shadow-[0_0_40px_var(--color-accent-glow),0_0_80px_var(--color-accent-dim),inset_0_-10px_30px_#006b52] animate-breathe flex items-center justify-center">
                  <span className="text-2xl">🔒</span>
                </div>
              </div>
            </div>

            {/* CTA Button */}
            <button
              onClick={handleEnterSanctuary}
              className="btn-primary text-lg px-10 py-4 shadow-[0_0_0_0_var(--color-accent-glow)] hover:shadow-[0_8px_32px_var(--color-accent-glow)] transition-all duration-300 group"
            >
              <span className="flex items-center gap-3">
                <span className="text-2xl">🔊</span>
                <span>Enter Sanctuary</span>
              </span>
            </button>

            <p className="mt-6 text-xs text-fg-muted/60 max-w-xs mx-auto">
              Connect wallet → Pay 0.1 USDC (Base or Solana) → Unlock forever
            </p>
          </div>
        </main>
      )}

      {/* Wallet Connection Phase */}
      {phase === 'connecting' && (
        <main className="flex-1 flex flex-col items-center justify-center px-4 py-12 relative">
          <div className="absolute inset-0 overflow-hidden pointer-events-none">
            <div className="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/10 rounded-full blur-3xl animate-pulse" />
            <div className="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl animate-pulse" style={{ animationDelay: '2s' }} />
          </div>

          <div className="relative z-10 w-full max-w-md">
            <div className="bg-card border border-border rounded-2xl p-8">
              <div className="text-center mb-8">
                <h2 className="font-heading text-3xl font-bold mb-2">Connect Wallet</h2>
                <p className="text-fg-muted">Choose your wallet to enter Ataraxia</p>
              </div>

              <div className="space-y-4 mb-8">
                <button
                  onClick={connectMetaMask}
                  disabled={wallet?.type === 'metamask'}
                  className="wallet-btn w-full flex items-center justify-center gap-3 px-6 py-4 bg-card border border-border rounded-xl text-fg text-base font-medium transition-all hover:border-accent hover:bg-bg-elevated disabled:opacity-50"
                >
                  <svg className="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.5}>
                    <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  <span>MetaMask / Coinbase Wallet (Base)</span>
                  {wallet?.type === 'metamask' && <span className="text-accent text-sm">✓ Connected</span>}
                </button>
                
                <button
                  onClick={connectPhantom}
                  disabled={wallet?.type === 'phantom'}
                  className="wallet-btn w-full flex items-center justify-center gap-3 px-6 py-4 bg-card border border-border rounded-xl text-fg text-base font-medium transition-all hover:border-accent hover:bg-bg-elevated disabled:opacity-50"
                >
                  <svg className="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.5}>
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                  </svg>
                  <span>Phantom (Solana)</span>
                  {wallet?.type === 'phantom' && <span className="text-accent text-sm">✓ Connected</span>}
                </button>
              </div>

              {wallet && (
                <div className="space-y-4">
                  <p className="text-center text-fg-muted text-sm">
                    Connected: <span className="text-fg font-mono">{formatAddress(wallet.address)}</span>
                  </p>
                  <div className="flex gap-3">
                    <button
                      onClick={() => { setSelectedChain('base'); initiatePayment(); }}
                      className={`flex-1 py-3 px-4 rounded-xl font-medium transition-all ${
                        selectedChain === 'base'
                          ? 'bg-accent-dim border border-accent text-accent'
                          : 'bg-bg border border-border text-fg-muted hover:border-accent hover:text-accent'
                      }`}
                    >
                      Base (USDC)
                    </button>
                    <button
                      onClick={() => { setSelectedChain('solana'); initiatePayment(); }}
                      className={`flex-1 py-3 px-4 rounded-xl font-medium transition-all ${
                        selectedChain === 'solana'
                          ? 'bg-accent-dim border border-accent text-accent'
                          : 'bg-bg border border-border text-fg-muted hover:border-accent hover:text-accent'
                      }`}
                    >
                      Solana (USDC)
                    </button>
                  </div>
                  <p className="text-center text-xs text-fg-muted/60">
                    Payment: 0.1 USDC • One-time • Permanent access
                  </p>
                </div>
              )}

              <button
                onClick={resetFlow}
                className="w-full mt-6 py-3 px-4 bg-transparent border border-border text-fg-muted rounded-xl hover:border-accent hover:text-accent transition-all"
              >
                Back
              </button>
            </div>
          </div>
        </main>
      )}

      {/* Payment Phase */}
      {phase === 'paying' && (
        <main className="flex-1 flex flex-col items-center justify-center px-4 py-12">
          <div className="w-full max-w-md">
            <div className="bg-card border border-border rounded-2xl p-8 text-center">
              <div className="w-20 h-20 mx-auto mb-6 rounded-full bg-accent-dim border border-accent flex items-center justify-center animate-pulse">
                <svg className="w-10 h-10 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.5}>
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
              </div>
              <h2 className="font-heading text-2xl font-bold mb-2">Initiating Payment</h2>
              <p className="text-fg-muted">Prompting wallet for {CONFIG.amount} USDC transfer...</p>
              
              {txHash && (
                <div className="mt-6 p-4 bg-bg border border-border rounded-xl font-mono text-xs text-fg-muted break-all">
                  {selectedChain === 'base' ? `Tx: ${txHash}` : `Sig: ${txHash}`}
                </div>
              )}
            </div>
          </div>
        </main>
      )}

      {/* Verifying Phase */}
      {phase === 'verifying' && (
        <main className="flex-1 flex flex-col items-center justify-center px-4 py-12">
          <div className="w-full max-w-md">
            <div className="bg-card border border-border rounded-2xl p-8 text-center">
              <div className="relative w-20 h-20 mx-auto mb-6">
                <div className="absolute inset-0 border-4 border-border rounded-full" />
                <div className="absolute inset-0 border-4 border-accent rounded-full spinner" />
                <div className="absolute inset-0 flex items-center justify-center">
                  <span className="text-3xl">⏳</span>
                </div>
              </div>
              <h2 className="font-heading text-2xl font-bold mb-2">Confirming Payment</h2>
              <p className="text-fg-muted mb-4">Verifying on-chain transaction...</p>
              <p className="text-sm text-fg-muted/70">{confirmations} / {CONFIG.requiredConfirmations[selectedChain]} confirmations</p>
              
              {txHash && (
                <div className="mt-6 p-4 bg-bg border border-border rounded-xl font-mono text-xs text-fg-muted break-all">
                  {selectedChain === 'base' ? `Tx: ${txHash}` : `Sig: ${txHash}`}
                </div>
              )}
            </div>
          </div>
        </main>
      )}

      {/* Sound Player - floating toggle, mounted once audio is needed */}
      <SoundPlayer onReady={() => setIsSoundPlayerReady(true)} />

      {/* Footer */}
      <footer className="py-6 px-4 border-t border-border/50">
        <p className="text-center text-xs text-fg-muted">
          ATARAXIA: Peace of Mind •{' '}
          <a href="https://xhagents.xyz" target="_blank" rel="noopener noreferrer" className="hover:text-accent">
            xhagents.xyz
          </a>{' '}
          • Wallet-gated • USDC 0.1
        </p>
      </footer>
    </div>
  );
}

export default App;