import { useEffect, useRef, useState, useCallback } from 'react';
import SoundPlayer from './components/SoundPlayer';

const PATTERNS = {
  box: [4000, 4000, 6000, 2000],
  '4-7-8': [4000, 7000, 8000, 1000],
  coherent: [5500, 0, 5500, 0],
};

const SOUND_LAYERS = [
  { id: 'rain', name: 'Rain', type: 'noise', color: '#4a90d9' },
  { id: 'wind', name: 'Wind', type: 'noise', color: '#7ab8f5' },
  { id: 'bowl', name: 'Singing Bowl', type: 'tone', freq: 261.63, color: '#d4a500' },
  { id: 'drone', name: 'Low Drone', type: 'tone', freq: 65.41, color: '#00d4aa' },
];

function Sanctuary({ wallet, onExit }) {
  const [breathPattern, setBreathPattern] = useState('box');
  const [breathPhase, setBreathPhase] = useState(0);
  const [activeLabel, setActiveLabel] = useState('inhale');
  const [soundNodes, setSoundNodes] = useState({});
  const [zenTool, setZenTool] = useState('rake');
  const [zenSand, setZenSand] = useState([]);
  const [audioContext, setAudioContext] = useState(null);
  
  const breathingCoreRef = useRef(null);
  const zenCanvasRef = useRef(null);
  const animationFrameRef = useRef(null);
  const breathTimeoutRef = useRef(null);
  const labelsRef = useRef({
    inhale: null,
    hold: null,
    exhale: null,
  });

  // Initialize Audio Context
  useEffect(() => {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    setAudioContext(ctx);
    
    // Initialize sound layers
    const nodes = {};
    SOUND_LAYERS.forEach(layer => {
      if (layer.type === 'noise') {
        const bufferSize = 2 * ctx.sampleRate;
        const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }
        const source = ctx.createBufferSource();
        source.buffer = noiseBuffer;
        source.loop = true;
        
        const gain = ctx.createGain();
        gain.gain.value = 0;
        
        const filter = ctx.createBiquadFilter();
        filter.type = layer.id === 'rain' ? 'lowpass' : 'highpass';
        filter.frequency.value = layer.id === 'rain' ? 800 : 1200;
        
        source.connect(filter).connect(gain).connect(ctx.destination);
        source.start(0);
        
        nodes[layer.id] = { source, gain, filter, playing: false };
      } else {
        const osc = ctx.createOscillator();
        osc.type = 'sine';
        osc.frequency.value = layer.freq;
        
        const gain = ctx.createGain();
        gain.gain.value = 0;
        
        osc.connect(gain).connect(ctx.destination);
        osc.start(0);
        
        nodes[layer.id] = { osc, gain, playing: false };
      }
    });
    setSoundNodes(nodes);
    
    return () => {
      Object.values(nodes).forEach(node => {
        if (node.source) node.source.stop();
        if (node.osc) node.osc.stop();
      });
      ctx.close();
    };
  }, []);

  // Breathing animation
  const updateLabels = useCallback((phaseName) => {
    setActiveLabel(phaseName);
    Object.keys(labelsRef.current).forEach(key => {
      if (labelsRef.current[key]) {
        labelsRef.current[key].classList.toggle('active', key === phaseName);
      }
    });
  }, []);

  const runBreathCycle = useCallback(() => {
    const pattern = PATTERNS[breathPattern];
    const phaseNames = ['inhale', 'hold', 'exhale', 'hold'];
    
    const nextPhase = () => {
      if (breathPhase >= pattern.length) {
        setBreathPhase(0);
        return nextPhase();
      }
      
      const dur = pattern[breathPhase];
      if (dur === 0) {
        setBreathPhase(p => p + 1);
        return nextPhase();
      }
      
      const phaseName = phaseNames[breathPhase];
      updateLabels(phaseName);
      
      const scale = ['inhale', 'hold'].includes(phaseName) ? 1.35 : phaseName === 'exhale' ? 0.85 : 1;
      if (breathingCoreRef.current) {
        breathingCoreRef.current.style.transform = `translate(-50%, -50%) scale(${scale})`;
      }
      
      setBreathPhase(p => p + 1);
      breathTimeoutRef.current = setTimeout(nextPhase, dur);
    };
    
    nextPhase();
  }, [breathPattern, breathPhase, updateLabels]);

  useEffect(() => {
    runBreathCycle();
    return () => {
      if (breathTimeoutRef.current) clearTimeout(breathTimeoutRef.current);
    };
  }, [runBreathCycle]);

  // Breathing pattern change
  const handlePatternChange = (pattern) => {
    setBreathPattern(pattern);
    setBreathPhase(0);
    if (breathTimeoutRef.current) clearTimeout(breathTimeoutRef.current);
    runBreathCycle();
  };

  // Sound controls
  const toggleSound = (layerId) => {
    const node = soundNodes[layerId];
    if (!node || !audioContext) return;
    
    if (node.playing) {
      node.gain.gain.setTargetAtTime(0, audioContext.currentTime, 0.5);
      node.playing = false;
    } else {
      node.gain.gain.setTargetAtTime(0.3, audioContext.currentTime, 0.5);
      node.playing = true;
    }
    setSoundNodes({ ...soundNodes });
  };

  const setSoundVolume = (layerId, volume) => {
    const node = soundNodes[layerId];
    if (!node || !audioContext) return;
    node.gain.gain.setTargetAtTime(volume * 0.5, audioContext.currentTime, 0.1);
  };

  // Zen Garden
  const initZenCanvas = useCallback(() => {
    const canvas = zenCanvasRef.current;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    ctx.fillStyle = '#1a1612';
    ctx.fillRect(0, 0, rect.width, rect.height);
  }, []);

  useEffect(() => {
    initZenCanvas();
    window.addEventListener('resize', initZenCanvas);
    return () => window.removeEventListener('resize', initZenCanvas);
  }, [initZenCanvas]);

  const drawSand = useCallback(() => {
    const canvas = zenCanvasRef.current;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    
    ctx.fillStyle = '#1a1612';
    ctx.fillRect(0, 0, rect.width, rect.height);
    
    zenSand.forEach(grain => {
      ctx.beginPath();
      ctx.arc(grain.x, grain.y, grain.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(212, 190, 150, ${grain.opacity})`;
      ctx.fill();
    });
    
    animationFrameRef.current = requestAnimationFrame(drawSand);
  }, [zenSand]);

  useEffect(() => {
    drawSand();
    return () => cancelAnimationFrame(animationFrameRef.current);
  }, [drawSand]);

  const handleCanvasInteraction = (e, isDrawing) => {
    const canvas = zenCanvasRef.current;
    if (!canvas) return;
    
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    if (zenTool === 'clear') {
      setZenSand([]);
      return;
    }
    
    if (isDrawing) {
      const newGrains = [];
      const count = zenTool === 'rake' ? 8 : 3;
      for (let i = 0; i < count; i++) {
        newGrains.push({
          x: x + (Math.random() - 0.5) * (zenTool === 'rake' ? 40 : 20),
          y: y + (Math.random() - 0.5) * (zenTool === 'rake' ? 40 : 20),
          size: Math.random() * (zenTool === 'rake' ? 3 : 5) + 1,
          opacity: Math.random() * 0.5 + 0.3,
        });
      }
      setZenSand(prev => [...prev, ...newGrains].slice(-2000));
    }
  };

  const handleMouseDown = (e) => {
    handleCanvasInteraction(e, true);
    const handleMove = (e) => handleCanvasInteraction(e, true);
    const handleUp = () => {
      window.removeEventListener('mousemove', handleMove);
      window.removeEventListener('mouseup', handleUp);
    };
    window.addEventListener('mousemove', handleMove);
    window.addEventListener('mouseup', handleUp);
  };

  const handleTouchStart = (e) => {
    e.preventDefault();
    const touch = e.touches[0];
    handleCanvasInteraction(touch, true);
    const handleMove = (e) => {
      e.preventDefault();
      handleCanvasInteraction(e.touches[0], true);
    };
    const handleEnd = () => {
      window.removeEventListener('touchmove', handleMove);
      window.removeEventListener('touchend', handleEnd);
    };
    window.addEventListener('touchmove', handleMove, { passive: false });
    window.addEventListener('touchend', handleEnd);
  };

  return (
    <div className="min-h-screen bg-bg flex flex-col">
      {/* Header */}
      <header className="px-4 py-4 flex items-center justify-between border-b border-border/50">
        <h1 className="font-heading text-2xl font-bold bg-gradient-to-r from-fg via-accent to-fg bg-clip-text text-transparent">
          ATARAXIA
        </h1>
        <div className="flex items-center gap-4">
          <span className="text-sm text-fg-muted font-mono">
            {wallet?.type === 'metamask' ? '🦊' : '👻'} {wallet?.address ? wallet.address.slice(0,6)+'...'+wallet.address.slice(-4) : ''}
          </span>
          <button
            onClick={onExit}
            className="px-4 py-2 bg-transparent border border-border text-fg-muted rounded-full hover:border-accent hover:text-accent transition-all text-sm"
          >
            Exit
          </button>
        </div>
      </header>

      <main className="flex-1 overflow-y-auto px-4 py-6">
        <div className="max-w-3xl mx-auto space-y-6">
          
          {/* Breathing Guide */}
          <section className="bg-card border border-border rounded-2xl p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="font-heading text-xl font-semibold">Breathing Guide</h2>
              <span className="text-xs text-fg-muted px-3 py-1 bg-bg rounded-full border border-border/50">Interactive</span>
            </div>
            
            <div className="relative w-64 h-64 mx-auto mb-6">
              <div className="absolute inset-0 border border-border/50 rounded-full" />
              <div
                ref={breathingCoreRef}
                className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full bg-gradient-to-br from-accent to-[#008a6d] shadow-[0_0_40px_var(--color-accent-glow),0_0_80px_var(--color-accent-dim),inset_0_-10px_30px_#006b52] animate-breathe flex items-center justify-center cursor-pointer"
                onClick={() => { setBreathPhase(0); runBreathCycle(); }}
              >
                <span className="text-3xl">🫁</span>
              </div>
              <div className="absolute inset-0 flex justify-between items-center px-4 pointer-events-none">
                <span ref={el => labelsRef.current.inhale = el} className="breathing-label text-xs text-fg-muted uppercase tracking-wider font-heading">Inhale</span>
                <span ref={el => labelsRef.current.hold = el} className="breathing-label text-xs text-fg-muted uppercase tracking-wider font-heading">Hold</span>
                <span ref={el => labelsRef.current.exhale = el} className="breathing-label text-xs text-fg-muted uppercase tracking-wider font-heading">Exhale</span>
              </div>
            </div>
            
            <div className="flex gap-2 justify-center flex-wrap">
              {Object.keys(PATTERNS).map(name => (
                <button
                  key={name}
                  onClick={() => handlePatternChange(name)}
                  className={`px-4 py-2 rounded-full text-sm font-heading transition-all ${
                    breathPattern === name
                      ? 'bg-accent-dim border border-accent text-accent'
                      : 'bg-bg border border-border text-fg-muted hover:border-accent hover:text-accent'
                  }`}
                >
                  {name === '4-7-8' ? '4-7-8' : name.charAt(0).toUpperCase() + name.slice(1)}
                </button>
              ))}
            </div>
          </section>

          {/* Soundscape */}
          <section className="bg-card border border-border rounded-2xl p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="font-heading text-xl font-semibold">Ambient Soundscape</h2>
              <span className="text-xs text-fg-muted px-3 py-1 bg-bg rounded-full border border-border/50">Web Audio</span>
            </div>
            
            <div className="space-y-3" id="soundscapeControls">
              {SOUND_LAYERS.map(layer => (
                <div key={layer.id} className="flex items-center gap-4 p-4 bg-bg border border-border rounded-xl">
                  <button
                    onClick={() => toggleSound(layer.id)}
                    className={`w-12 h-12 rounded-full flex items-center justify-center transition-all ${
                      soundNodes[layer.id]?.playing
                        ? 'bg-accent border-accent text-bg'
                        : 'bg-card border border-border text-fg-muted'
                    }`}
                    aria-label={layer.name}
                  >
                    <svg className="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.5}>
                      {soundNodes[layer.id]?.playing ? (
                        <>
                          <rect x="6" y="4" width="4" height="16" />
                          <rect x="14" y="4" width="4" height="16" />
                        </>
                      ) : (
                        <>
                          <path d="M11 5L6 9H2v6h4l5 4V5z" />
                          <path d="M19 9l4 4-4 4M22 9l-4 4 4 4" />
                        </>
                      )}
                    </svg>
                  </button>
                  <div className="flex-1">
                    <div className="font-medium">{layer.name}</div>
                    <input
                      type="range"
                      min="0"
                      max="1"
                      step="0.05"
                      value={soundNodes[layer.id]?.playing ? 0.6 : 0}
                      onChange={(e) => setSoundVolume(layer.id, parseFloat(e.target.value))}
                      className="w-full h-1.5 appearance-none bg-border rounded-full accent-accent mt-1"
                      aria-label={`${layer.name} volume`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Zen Garden */}
          <section className="bg-card border border-border rounded-2xl p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="font-heading text-xl font-semibold">Zen Garden</h2>
              <span className="text-xs text-fg-muted px-3 py-1 bg-bg rounded-full border border-border/50">Sand Raking</span>
            </div>
            
            <div className="relative rounded-xl overflow-hidden border border-border" style={{ backgroundColor: '#1a1612' }}>
              <canvas
                ref={zenCanvasRef}
                className="w-full block touch-none"
                style={{ aspectRatio: '4/3' }}
                onMouseDown={handleMouseDown}
                onTouchStart={handleTouchStart}
              />
            </div>
            
            <div className="flex gap-2 justify-center flex-wrap mt-4" id="zenTools">
              {[
                { id: 'rake', name: 'Rake', icon: '🌾' },
                { id: 'circle', name: 'Circle', icon: '⭕' },
                { id: 'dot', name: 'Dot', icon: '⬤' },
                { id: 'clear', name: 'Clear', icon: '🗑️' },
              ].map(tool => (
                <button
                  key={tool.id}
                  onClick={() => setZenTool(tool.id)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition-all ${
                    zenTool === tool.id
                      ? 'bg-accent-dim border border-accent text-accent'
                      : 'bg-bg border border-border text-fg-muted hover:border-accent hover:text-accent'
                  }`}
                >
                  <span>{tool.icon}</span>
                  <span>{tool.name}</span>
                </button>
              ))}
            </div>
          </section>
        </div>
      </main>

      {/* Floating Sound Player */}
      <SoundPlayer onReady={() => {}} />
      
      {/* Footer */}
      <footer className="py-4 px-4 border-t border-border/50">
        <p className="text-center text-xs text-fg-muted">
          ATARAXIA: Peace of Mind •{' '}
          <a href="https://xhagents.xyz" target="_blank" rel="noopener noreferrer" className="hover:text-accent">
            xhagents.xyz
          </a>
        </p>
      </footer>
    </div>
  );
}

export default Sanctuary;